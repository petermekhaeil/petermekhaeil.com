---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/base.astro';
import profileImage from '/public/assets/profile.png';

export const prerender = true;
---

<BaseLayout>
  <h1 class="mb-1 text-2xl font-bold">About</h1>
  <Image
    class="mx-auto mt-2 mb-4 block rounded-lg bg-gray-100 sm:float-right sm:ml-4 sm:mb-4"
    src={profileImage}
    alt="Peter Mekhaeil"
    height={160}
    width={160}
    loading="eager"
  />
  <p class="my-6">
    My name is Peter and I am passionate about frontend development. I am
    currently based in Singapore, where I work as a software engineer at Credit
    Suisse.
  </p>
  <p class="my-6">
    I was born in Egypt and raised in Australia. This diverse upbringing
    background sparked my love for computers, cars, and the outdoors. When I'm
    not working on the web, you can find me running and exploring new outdoor
    locations.
  </p>
  <h2 class="my-8 text-xl font-bold">Companies I've worked with</h2>
  <ul class="my-8 list-none space-y-2 text-sm">
    <li>
      <div class="flex">
        <div class="shrink-0 basis-28 text-gray-500">Singapore</div>
        <a href="https://www.credit-suisse.com">Credit Suisse</a>
      </div>
    </li>
    <li>
      <div class="flex">
        <div class="shrink-0 basis-28 text-gray-500">Singapore</div>
        <a href="https://shop.singtel.com">Singtel</a>
      </div>
    </li>
    <li>
      <div class="flex">
        <div class="shrink-0 basis-28 text-gray-500">Australia</div>
        <a href="https://www.optus.com.au/">Optus</a>
      </div>
    </li>
    <li>
      <div class="flex">
        <div class="shrink-0 basis-28 text-gray-500">Australia</div>
        <a href="https://news.com.au/">News Corp</a>
      </div>
    </li>
  </ul>
  <p>
    I share my professional achievements on <a
      target="_blank"
      class="border-b border-gray-300 text-gray-600 transition-[border-color] hover:border-gray-600"
      href="https://www.linkedin.com/in/petermekhaeil/">LinkedIn</a
    >.
  </p>
</BaseLayout>
