---
import { ChartTotalVisits } from '../../components/ChartTotalVisits';
import BaseLayout from '../../layouts/base.astro';
import { neon } from '@neondatabase/serverless';

export const prerender = false;

Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, max-age=3600, must-revalidate'
);

const sql = neon(import.meta.env.DATABASE_URL);

interface AnalyticsData {
  id: number;
  date: string;
  path: string;
  referrer: string;
  country: string;
  city: string | null;
  flag: string;
  bot_name: string | null;
}

let table: AnalyticsData[] = [];

try {
  const response = await sql`
    SELECT * FROM analytics
    WHERE date >= NOW() - INTERVAL '30 days'`;

  if (!response.length) {
    throw new Error('No analytics data found');
  }

  table = response as AnalyticsData[];

  if (import.meta.env.PROD) {
    table = table.filter(
      (item) => item.city !== 'Mock City' && !item.referrer?.includes('localhost')
    );
  }
} catch (error) {
  console.error('Analytics fetch error:', error);
}

/**
 * Generic grouping utility - reduces repetition
 */
function groupBy<T extends Record<string, unknown>, R extends { total: number }>(
  array: T[],
  keyFn: (item: T) => string | null,
  initFn: (item: T) => R
): R[] {
  const grouped = new Map<string, R>();

  for (const item of array) {
    const key = keyFn(item);
    if (key === null) continue;

    const existing = grouped.get(key);
    if (existing) {
      existing.total++;
    } else {
      grouped.set(key, initFn(item));
    }
  }

  return Array.from(grouped.values());
}

/**
 * Sort by total descending and take top N
 */
function topN<T extends { total: number }>(items: T[], n: number): T[] {
  return items.sort((a, b) => b.total - a.total).slice(0, n);
}

const formatDateKey = (date: Date): string => {
  const day = date.getDate().toString().padStart(2, '0');
  const month = new Intl.DateTimeFormat('en', { month: 'short' }).format(date);
  return `${day}-${month}`;
};

const groupByDate = (array: AnalyticsData[]) => {
  const grouped = groupBy(
    array,
    (item) => formatDateKey(new Date(item.date)),
    (item) => ({ date: formatDateKey(new Date(item.date)), total: 1 })
  );

  const groupedMap = new Map(grouped.map((g) => [g.date, g]));

  // Fill in missing days with zero values
  const result: { date: string; total: number }[] = [];
  const currentDate = new Date();
  const thirtyDaysAgo = new Date();
  thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

  while (thirtyDaysAgo <= currentDate) {
    const key = formatDateKey(thirtyDaysAgo);
    result.push(groupedMap.get(key) ?? { date: key, total: 0 });
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() + 1);
  }

  return result;
};

const normalizeReferrer = (referrer: string | null): string => {
  if (!referrer) return '';
  return referrer.includes('petermekhaeil.com')
    ? 'https://petermekhaeil.com'
    : referrer;
};

// Pre-compute grouped data (avoid calling in template multiple times)
const dateData = groupByDate(table);

const referrerData = topN(
  groupBy(
    table,
    (item) => normalizeReferrer(item.referrer) || null,
    (item) => ({ referrer: normalizeReferrer(item.referrer), total: 1 })
  ).filter((item) => item.referrer !== ''),
  10
);

const pathData = topN(
  groupBy(
    table,
    (item) => item.path,
    (item) => ({ path: item.path, total: 1 })
  ),
  10
);

const cityData = topN(
  groupBy(
    table,
    (item) => (item.city ? `${item.country}-${item.city}` : null),
    (item) => ({ city: item.city, country: item.country, flag: item.flag, total: 1 })
  ),
  10
);

const botData = topN(
  groupBy(
    table,
    (item) => item.bot_name,
    (item) => ({ bot_name: item.bot_name!, total: 1 })
  ),
  10
);
---

<BaseLayout>
  <h1 class="mb-1 text-2xl font-bold">Analytics</h1>
  {
    table.length > 0 ? (
      <div class="m-auto my-8 mb-12 max-w-2xl text-sm">
        <h2 class="my-8 text-xl font-bold">Total Visits</h2>
        <ChartTotalVisits client:load data={dateData} />

        <h2 class="my-8 text-xl font-bold">Top Bots</h2>
        <div class="py-2 font-medium text-gray-500">
          <span class="grid grid-cols-8">
            <span class="col-span-7">Crawler</span>
            <span class="col-span-1">Count</span>
          </span>
        </div>
        {botData.length > 0 ? (
          <ul>
            {botData.map((item) => (
              <li class="transition-[background-color] hover:bg-gray-100 active:bg-gray-200">
                <span class="grid grid-cols-8 gap-2 border-t border-gray-200 py-2">
                  <span class="col-span-7">{item.bot_name}</span>
                  <span class="col-span-1 text-gray-500">{item.total}</span>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="py-2 text-gray-500 border-t border-gray-200">No bot visits recorded yet.</p>
        )}

        <h2 class="my-8 text-xl font-bold">Top Referrers</h2>
        <div class="py-2 font-medium text-gray-500">
          <span class="grid grid-cols-8">
            <span class="col-span-7">Referrers</span>
            <span class="col-span-1">Count</span>
          </span>
        </div>
        <ul>
          {referrerData.map((item) => (
            <li class="transition-[background-color] hover:bg-gray-100 active:bg-gray-200">
              <span class="grid grid-cols-8 gap-2 border-t border-gray-200 py-2">
                <span class="col-span-7">{item.referrer}</span>
                <span class="col-span-1 text-gray-500">{item.total}</span>
              </span>
            </li>
          ))}
        </ul>

        <h2 class="my-8 text-xl font-bold">Top Posts</h2>
        <div class="py-2 font-medium text-gray-500">
          <span class="grid grid-cols-8">
            <span class="col-span-7">Post</span>
            <span class="col-span-1">Count</span>
          </span>
        </div>
        <ul>
          {pathData.map((item) => (
            <li class="transition-[background-color] hover:bg-gray-100 active:bg-gray-200">
              <a href={item.path}>
                <span class="grid grid-cols-8 gap-2 border-t border-gray-200 py-2">
                  <span class="col-span-7">{item.path}</span>
                  <span class="col-span-1 text-gray-500">{item.total}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <h2 class="my-8 text-xl font-bold">Top Cities</h2>
        <div class="py-2 font-medium text-gray-500">
          <span class="grid grid-cols-8">
            <span class="col-span-7">City</span>
            <span class="col-span-1">Count</span>
          </span>
        </div>
        <ul>
          {cityData.map((item) => (
            <li class="transition-[background-color] hover:bg-gray-100 active:bg-gray-200">
              <span class="grid grid-cols-8 gap-2 border-t border-gray-200 py-2">
                <span class="col-span-7">
                  {item.flag} {item.city}
                </span>
                <span class="col-span-1 text-gray-500">{item.total}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class="text-gray-500">No analytics data available.</p>
    )
  }
</BaseLayout>
